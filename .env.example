# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NEAR AI credentials (server-side only; never commit real keys).
NEARAI_API_KEY=""

# Operator-approved deployment measurements for NEAR AI TEE verification.
# The model ID (z-ai/glm-5.3-flash) is hardcoded in the adapter and is not operator-configurable.
# Both compose hash and OS image hash must be set to enable optional NEAR AI inference.
NEARAI_OPERATOR_APPROVED_COMPOSE_HASH=""
NEARAI_OPERATOR_APPROVED_OS_IMAGE_HASH=""

# Optional Meta Model API credentials (server-side only; never reuse NEARAI_API_KEY or commit real keys).
# Restricted to public/synthetic fixtures; free-credit submissions may be used by Meta for product improvement.
META_MODEL_API_KEY=""
